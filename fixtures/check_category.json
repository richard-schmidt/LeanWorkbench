{"file": "SyntheticSystems/Systems/Category.lean", "seconds": 23.81, "text": "import SyntheticSystems.Systems.Hom\nimport Mathlib.CategoryTheory.Category.Basic\n\nnamespace Systems\n\n@[simp]\ndef Hom.id (S : System) : Hom S S := by\n  refine ⟨fun e => {e}, fun d => {d}, ?_⟩\n  intro e d h e' he d' hd\n  have he' : e' = e := by simpa using he\n  have hd' : d' = d := by simpa using hd\n  subst he'\n  subst hd'\n  exact h\n\n@[simp]\ndef Hom.comp {S T U : System} (f : Hom S T) (g : Hom T U) : Hom S U := by\n  refine ⟨?onEntity, ?onDomain, ?preserve⟩\n  · intro e; exact {u | ∃ t, t ∈ f.onEntity e ∧ u ∈ g.onEntity t}\n  · intro d; exact {u | ∃ t, t ∈ f.onDomain d ∧ u ∈ g.onDomain t}\n  · intro e d h e' he d' hd\n    rcases he with ⟨tE, htE, he'⟩\n    rcases hd with ⟨tD, htD, hd'⟩\n    exact g.preserve (f.preserve h tE htE tD htD) e' he' d' hd'\n\nopen CategoryTheory\n\ninstance : Category System where\n  Hom := Hom\n  id := Hom.id\n  comp := fun f g => Hom.comp f g\n  id_comp := by\n    intros X Y F\n    ext\n    · dsimp [Hom.comp, Hom.id]\n      simp\n    · dsimp [Hom.comp, Hom.id]\n      simp\n\nend Systems\n", "diagnostics": [], "declarations": [{"line": 7, "kind": "def", "name": "Hom.id", "end_line": 14, "status": "ok"}, {"line": 17, "kind": "def", "name": "Hom.comp", "end_line": 24, "status": "ok"}, {"line": 28, "kind": "instance", "name": null, "end_line": 38, "status": "ok"}], "goals": [{"line": 10, "goals": [{"case": null, "hyps": [{"names": ["S"], "type": "System"}, {"names": ["e"], "type": "Entity"}, {"names": ["d"], "type": "Domain"}, {"names": ["h"], "type": "S.entityDomain e d"}, {"names": ["e'"], "type": "Entity"}, {"names": ["he"], "type": "e' ∈ {e}"}, {"names": ["d'"], "type": "Domain"}, {"names": ["hd"], "type": "d' ∈ {d}"}], "target": "S.entityDomain e' d'"}]}, {"line": 22, "goals": [{"case": "preserve", "hyps": [{"names": ["S", "T", "U"], "type": "System"}, {"names": ["f"], "type": "Hom S T"}, {"names": ["g"], "type": "Hom T U"}, {"names": ["e"], "type": "Entity"}, {"names": ["d"], "type": "Domain"}, {"names": ["h"], "type": "S.entityDomain e d"}, {"names": ["e'"], "type": "Entity"}, {"names": ["he"], "type": "e' ∈ {u | ∃ t ∈ f.onEntity e, u ∈ g.onEntity t}"}, {"names": ["d'"], "type": "Domain"}, {"names": ["hd"], "type": "d' ∈ {u | ∃ t ∈ f.onDomain d, u ∈ g.onDomain t}"}], "target": "U.entityDomain e' d'"}]}], "goals_after": [{"line": 22, "goals": [{"case": "preserve", "hyps": [{"names": ["S", "T", "U"], "type": "System"}, {"names": ["f"], "type": "Hom S T"}, {"names": ["g"], "type": "Hom T U"}, {"names": ["e"], "type": "Entity"}, {"names": ["d"], "type": "Domain"}, {"names": ["h"], "type": "S.entityDomain e d"}, {"names": ["e'"], "type": "Entity"}, {"names": ["d'"], "type": "Domain"}, {"names": ["hd"], "type": "d' ∈ {u | ∃ t ∈ f.onDomain d, u ∈ g.onDomain t}"}, {"names": ["tE"], "type": "Entity"}, {"names": ["htE"], "type": "tE ∈ f.onEntity e"}, {"names": ["he'"], "type": "e' ∈ g.onEntity tE"}], "target": "U.entityDomain e' d'"}]}, {"line": 24, "goals": []}], "tokens": [[1, 0, 6, "keyword"], [2, 0, 6, "keyword"], [4, 0, 9, "keyword"], [6, 2, 4, "keyword"], [7, 0, 3, "keyword"], [7, 12, 1, "variable"], [7, 30, 1, "variable"], [7, 32, 1, "variable"], [7, 37, 2, "keyword"], [8, 2, 6, "keyword"], [8, 10, 3, "keyword"], [8, 14, 1, "variable"], [8, 20, 1, "variable"], [8, 24, 3, "keyword"], [8, 28, 1, "variable"], [8, 34, 1, "variable"], [8, 39, 1, "keyword"], [9, 2, 5, "keyword"], [9, 8, 1, "variable"], [9, 10, 1, "variable"], [9, 12, 1, "variable"], [9, 14, 2, "variable"], [9, 17, 2, "variable"], [9, 20, 2, "variable"], [9, 23, 2, "variable"], [10, 2, 4, "keyword"], [10, 7, 3, "variable"], [10, 13, 2, "variable"], [10, 18, 1, "variable"], [10, 23, 2, "keyword"], [10, 26, 5, "keyword"], [10, 32, 5, "keyword"], [10, 38, 2, "variable"], [11, 2, 4, "keyword"], [11, 7, 3, "variable"], [11, 13, 2, "variable"], [11, 18, 1, "variable"], [11, 23, 2, "keyword"], [11, 26, 5, "keyword"], [11, 32, 5, "keyword"], [11, 38, 2, "v