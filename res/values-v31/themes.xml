<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system splash shows only the background: the lattice splash is drawn in Compose
         (LatticeSplashOverlay), so a system icon would flash the finished mark first. -->
    <style name="Theme.LeanWb" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
